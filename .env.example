# ==============================================================================
# THE EVERGREEN EXPRESS — A SECRET CHRISTMAS JOURNEY
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file and name it '.env' (in the same root directory).
# 2. Fill in your Supabase connection string and email credentials in .env.
# 3. NEVER share your real '.env' file or commit it to GitHub.
# ==============================================================================

# SUPABASE POSTGRESQL CONNECTION STRING (Session Pooler URI format)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> Session pooler (URI)
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# DATABASE SSL CONFIGURATION
# Set to 'false' for Supabase Session Pooler connections with standard SSL encryption
DATABASE_SSL_STRICT=false

# SERVER CONFIGURATION
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# SESSION SECRET (Used for cryptographically signing session cookies)
SESSION_SECRET="your-long-random-secret-key-replace-with-random-string"

# INITIAL ADMIN BOOTSTRAP (Used only to create the initial admin account if none exists)
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="ChristmasAdmin2026!"
ADMIN_DEFAULT_EMAIL="admin@college.edu"

# ==============================================================================
# GMAIL SMTP EMAIL DELIVERY CONFIGURATION
# ==============================================================================
# Uses Gmail SMTP via Nodemailer to deliver OTP emails to ANY participant address.
# 1. Turn ON 2-Step Verification: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
#    - App name: "Evergreen Express"
#    - Copy the generated 16-character password (e.g. abcd efgh ijkl mnop)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-dedicated-gmail@gmail.com
SMTP_APP_PASSWORD=your-16-character-app-password
SMTP_FROM=THE EVERGREEN EXPRESS <your-dedicated-gmail@gmail.com>

# OFFLINE DEVELOPMENT SIMULATOR
# Set to 'true' ONLY if you want to test registration offline without internet
ENABLE_EMAIL_SIMULATOR=false
